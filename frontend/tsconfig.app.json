{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* 路径别名：与 vite.config.ts 的 resolve.alias 保持一致。
       TS 6 起 baseUrl 已废弃，paths 直接相对于本 tsconfig 所在目录解析 */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /* 开发期验收夹具（vite dev 直接跑、不进生产 bundle）。
     它们手工拼 ViewContext 字面量，纳入类型检查会在契约演进时打断构建，
     所以排除在外；夹具若要改契约，请在真外壳里验证。 */
  "exclude": ["src/**/__lab__/**"]
}
